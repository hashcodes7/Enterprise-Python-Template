# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.prod)
# Enterprise FastAPI Backend
# ==============================================================================

# Core Application Settings
APP_ENV=prod
APP_NAME=Enterprise FastAPI Backend
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Security & Tokens (Production strict secrets)
SECRET_KEY=prod_super_secure_vault_generated_secret_key_987654321_enterprise
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://app.enterprise.internal","https://api.enterprise.internal"]

# Database & Cache (Production PostgreSQL / Managed Redis)
DATABASE_URL=postgresql+asyncpg://app_admin:SecureProdPassword2026!@postgres-cluster.internal:5432/enterprise_backend_prod
REDIS_URL=redis://:RedisProdPass2026@redis-cluster.internal:6379/0
