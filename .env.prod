# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.prod)
# Multi-Agent Business Operations Platform
# ==============================================================================

# Core Application Settings
APP_ENV=prod
APP_NAME=Multi-Agent Business Operations Platform
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Security & Tokens (Production strict secrets)
SECRET_KEY=prod_super_secure_vault_generated_secret_key_987654321_enterprise
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://ops.enterprise.internal","https://api.enterprise.internal"]

# Database & Cache (Production PostgreSQL / Managed Redis)
DATABASE_URL=postgresql+asyncpg://ops_admin:SecureProdPassword2026!@postgres-cluster.internal:5432/business_ops_prod
REDIS_URL=redis://:RedisProdPass2026@redis-cluster.internal:6379/0

# Multi-Agent Engine Parameters (Enterprise Scale)
AGENT_MAX_CONCURRENT_TASKS=50
AGENT_EXECUTION_TIMEOUT_SECONDS=300
AGENT_MOCK_EXTERNAL_APIS=false
ENABLE_AGENT_TELEMETRY=true

# External Provider Integrations (Enterprise Vault Keys)
LLM_API_KEY=sk-prod-enterprise-key-vault-reference-2026
LLM_MODEL=gpt-4o
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/prod_webhook_token
