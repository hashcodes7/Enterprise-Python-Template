# ==============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.dev)
# Multi-Agent Business Operations Platform
# ==============================================================================

# Core Application Settings
APP_ENV=dev
APP_NAME=Multi-Agent Business Operations Platform [DEV]
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Security & Tokens (Dev defaults)
SECRET_KEY=dev_insecure_secret_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database & Cache (Development SQLite/Local Redis)
DATABASE_URL=sqlite+aiosqlite:///./dev_business_platform.db
REDIS_URL=redis://127.0.0.1:6379/0

# Multi-Agent Engine Parameters
AGENT_MAX_CONCURRENT_TASKS=5
AGENT_EXECUTION_TIMEOUT_SECONDS=60
AGENT_MOCK_EXTERNAL_APIS=true
ENABLE_AGENT_TELEMETRY=false

# External Provider Integrations (Mock / Sandbox)
LLM_API_KEY=mock-dev-llm-key-sandbox
LLM_MODEL=gpt-4o-mini
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/DEV_WORKSPACE/MOCK_CHANNEL/TEST
