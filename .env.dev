# ==============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.dev)
# Enterprise FastAPI Backend
# ==============================================================================

# Core Application Settings
APP_ENV=dev
APP_NAME=Enterprise FastAPI Backend [DEV]
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Security & Tokens (Dev defaults)
SECRET_KEY=dev_insecure_secret_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database & Cache (Development SQLite/Local Redis)
DATABASE_URL=sqlite+aiosqlite:///./dev_backend.db
REDIS_URL=redis://127.0.0.1:6379/0
