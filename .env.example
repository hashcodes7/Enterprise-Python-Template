# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Copy this to .env or use .env.dev / .env.prod directly
# ==============================================================================

# Core Application Settings
APP_ENV=dev
APP_NAME=Enterprise FastAPI Backend
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Security & Tokens
SECRET_KEY=replace_with_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./backend.db
REDIS_URL=redis://localhost:6379/0
